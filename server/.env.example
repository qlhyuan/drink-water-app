# ===== 数据库 =====
# SQLite 相对路径是相对 server/prisma/schema.prisma 解析的，
# 所以 ../data/dev.db 实际落在 server/data/dev.db
DATABASE_URL="file:../data/dev.db"

# ===== JWT（可选）=====
# 不设置（或留占位值）时，系统启动会自动生成一个强随机密钥，
# 并持久化到 data/.jwt-secret —— 重启/重新部署后已登录用户 token 依然有效。
# 如需固定密钥（例如多实例共享），再取消注释手动设置：
# JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# ===== 管理员账号（可选）=====
# 设置后首次启动会自动创建管理员账号；已存在时不覆盖密码。
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD="change-me-please"
# ADMIN_NICKNAME="管理员"

# ===== 飞书集成（可选）=====
# 在 https://open.feishu.cn 创建企业自建应用，获取 App ID / App Secret；
# 开启「机器人」+「网页应用」能力，配置重定向 URL 为：
#   ${APP_BASE_URL}/feishu/callback
# 申请权限：im:message（发消息）、contact:user.base:readonly（获取用户身份）
# 未配置时飞书登录与提醒自动禁用，不影响原有账号密码登录。
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""
# 飞书授权回调地址（前端页面），生产环境务必改成你的真实域名
FEISHU_REDIRECT_URI="http://localhost:3001/feishu/callback"
# 应用对外地址（用于提醒卡片里的「去记录喝水」按钮跳转）
APP_BASE_URL="http://localhost:3001"

PORT=3001
NODE_ENV=production
CORS_ORIGIN=""

# ===== AI（可选）=====
# 个性化饮水建议的 LLM 服务，默认走 DeepSeek（OpenAI 兼容协议）。
# AI_API_KEY 留空时，/api/ai/advice 会返回降级文案，AI 卡片仍可正常展示。
# DeepSeek 申请：https://platform.deepseek.com/
# 通义千问申请：https://dashscope.console.aliyun.com/
# OpenAI 申请：https://platform.openai.com/
# AI_PROVIDER="deepseek"
# AI_API_KEY=""
# AI_BASE_URL=""          # 可选：自定义 baseURL，留空走 provider 默认
# AI_MODEL=""             # 可选：自定义模型，留空走 provider 默认
# AI_TIMEOUT_MS="15000"   # 调用超时时间（毫秒）

# ===== 天气默认城市（可选）=====
# 首页天气默认城市。未设置时浏览器自动调用 IP 定位（后端 /api/geo/ip）。
# 设置后：服务侧首选使用这个城市，跳过 IP 定位步骤。
# DEFAULT_WEATHER_CITY="北京"
