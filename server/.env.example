# ===== 数据库 =====
# SQLite 相对路径是相对 server/prisma/schema.prisma 解析的，
# 所以 ../data/dev.db 实际落在 server/data/dev.db
DATABASE_URL="file:../data/dev.db"

# ===== JWT（可选）=====
# 不设置（或留占位值）时，系统启动会自动生成一个强随机密钥，
# 并持久化到 data/.jwt-secret —— 重启/重新部署后已登录用户 token 依然有效。
# 如需固定密钥（例如多实例共享），再取消注释手动设置：
# JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# ===== 管理员账号（可选）=====
# 设置后首次启动会自动创建管理员账号；已存在时不覆盖密码。
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD="change-me-please"
# ADMIN_NICKNAME="管理员"

PORT=3001
NODE_ENV=production
CORS_ORIGIN=""
