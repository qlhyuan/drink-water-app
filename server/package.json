{
  "name": "drink-water-server",
  "version": "1.0.0",
  "description": "每日喝水 - 后端服务",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "prisma:generate": "prisma generate",
