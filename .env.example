# ============================================================
# docker-compose 配置模板（放在 docker-compose.yml 同目录）
# 用法：复制本文件为 .env，然后填写你的值：
#   cp .env.example .env
#   docker-compose up -d
# 说明：compose 会自动读取同目录 .env 里的变量，替换
#       docker-compose.yml 中的 ${VAR:-默认值} 占位。
# ============================================================

# 管理员账号：设置后首次启动自动创建，已存在则不覆盖密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成你的强密码
ADMIN_NICKNAME=管理员

# 浏览器跨域来源（一般留空即可，前端与后端同源部署）
CORS_ORIGIN=

# 服务器时区（默认上海，影响日志、统计边界等；提醒 Worker 已使用用户存储的时区偏移）
TZ=Asia/Shanghai

# 镜像来源（可选）：默认使用 ghcr.io（GitHub 构建产物）；
# 国内拉取慢可切换到阿里云 ACR，值为：
#   registry.cn-hangzhou.aliyuncs.com/<命名空间>/drink-water-app:latest
# 设置后 docker compose up -d --pull always 会从阿里云拉取镜像
# ALIYUN_IMAGE=

# ===== 飞书集成（可选）=====
# 在 https://open.feishu.cn 创建企业自建应用，获取 App ID / App Secret；
# 开启「机器人」+「网页应用」能力；重定向 URL 配置为：
#   ${APP_BASE_URL}/feishu/callback
# 申请权限：im:message、contact:user.base:readonly
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书授权回调地址（前端页面），务必改成你的真实域名，如 https://drink.example.com/feishu/callback
FEISHU_REDIRECT_URI=
# 应用对外地址（提醒卡片「去记录喝水」按钮跳转目标）
APP_BASE_URL=

# 如需固定 JWT 密钥（多实例共享时才需要）：
# 取消 docker-compose.yml 中 JWT_SECRET 那行的注释，再取消下面这行注释
# JWT_SECRET=
